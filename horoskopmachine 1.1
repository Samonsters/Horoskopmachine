<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport"
        content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no">

  <meta name="theme-color" content="#000000">

  <title>Du</title>

  <style>
    * {
      box-sizing: border-box;
    }

    html, body {
      margin: 0;
      width: 100%;
      height: 100%;
      background: #000;
      overflow: hidden;
      font-family: Arial, Helvetica, sans-serif;
      color: #fff;
    }

    body {
      position: relative;
    }

    #video {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transform: scaleX(-1);
      background: #000;
    }

    .shade {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(
          to bottom,
          rgba(0,0,0,.22),
          transparent 25%,
          transparent 70%,
          rgba(0,0,0,.3)
        );
      pointer-events: none;
    }

    #status {
      position: absolute;
      top: max(24px, env(safe-area-inset-top));
      left: 50%;
      transform: translateX(-50%);
      width: 90%;

      font-size: 14px;
      letter-spacing: .08em;
      text-transform: uppercase;
      opacity: .85;
      text-align: center;

      z-index: 5;
    }

    #progressWrap {
      position: absolute;
      bottom: max(28px, calc(env(safe-area-inset-bottom) + 18px));
      left: 50%;
      transform: translateX(-50%);

      width: min(320px, 72vw);
      height: 2px;

      background: rgba(255,255,255,.28);
      overflow: hidden;

      z-index: 5;
    }

    #progress {
      width: 0%;
      height: 100%;
      background: #fff;
      transition: width .05s linear;
    }

    #message {
      position: absolute;
      inset: 0;

      display: flex;
      align-items: center;
      justify-content: center;

      padding: 8vw;

      background: rgba(0,0,0,.72);

      text-align: center;

      font-size: clamp(28px, 5vw, 64px);
      line-height: 1.08;
      font-weight: 500;

      opacity: 0;
      pointer-events: none;

      transition: opacity .45s ease;

      z-index: 20;
    }

    #message.show {
      opacity: 1;
      pointer-events: auto;
    }

    #restart {
      position: absolute;

      bottom: max(34px, calc(env(safe-area-inset-bottom) + 24px));
      left: 50%;
      transform: translateX(-50%);

      border: 1px solid rgba(255,255,255,.7);
      background: transparent;
      color: white;

      border-radius: 999px;
      padding: 12px 18px;

      font-size: 14px;

      display: none;

      z-index: 25;
    }

    #message.show + #restart {
      display: block;
    }

    #start {
      position: absolute;
      inset: 0;

      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;

      gap: 18px;
      padding: 30px;

      text-align: center;

      background: #000;

      z-index: 30;
    }

    #start button {
      border: 1px solid #fff;
      background: #fff;
      color: #000;

      border-radius: 999px;

      padding: 14px 22px;

      font-size: 17px;
    }

    #start button:disabled {
      opacity: .5;
    }

    #start p {
      max-width: 420px;
      opacity: .72;
      line-height: 1.4;
      margin: 0;
    }

    #error {
      max-width: 500px;
      color: #ff8a8a;
      font-size: 13px;
      line-height: 1.4;
      display: none;
    }

    .hidden {
      display: none !important;
    }
  </style>
</head>

<body>

  <video
    id="video"
    autoplay
    playsinline
    muted>
  </video>

  <div class="shade"></div>

  <div id="status">
    Kamera bereit
  </div>

  <div id="progressWrap">
    <div id="progress"></div>
  </div>

  <div id="message"></div>

  <button id="restart">
    Noch einmal
  </button>

  <div id="start">

    <button id="startBtn">
      Kamera starten
    </button>

    <p id="instructions">
      Tippe auf „Kamera starten“ und erlaube den Kamerazugriff.
      Danach schaue für 5 Sekunden in die Kamera.
    </p>

    <div id="error"></div>

  </div>


<script type="module">

/* =========================================================
   MEDIAPIPE
   ========================================================= */

import {
  FaceDetector,
  FilesetResolver
} from "https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.22/+esm";


/* =========================================================
   AUSSAGEN
   ========================================================= */

const statements = [

  "Du hast ein großes Bedürfnis danach, von anderen gemocht und geschätzt zu werden.",

  "Manchmal zweifelst du daran, ob du die richtigen Entscheidungen getroffen hast.",

  "Obwohl du nach außen selbstsicher wirkst, bist du innerlich nicht immer so überzeugt von dir selbst.",

  "Du besitzt Fähigkeiten, die du bisher noch nicht vollständig genutzt hast.",

  "In letzter Zeit hast du über eine Veränderung nachgedacht, die dir wichtig erscheint.",

  "Du schätzt Ehrlichkeit, kannst aber diplomatisch sein, wenn die Situation es verlangt.",

  "Es fällt dir schwer, dich von bestimmten Dingen oder Menschen zu lösen.",

  "Du brauchst gelegentlich Zeit für dich allein, auch wenn du gerne mit anderen zusammen bist.",

  "Manche Menschen unterschätzen dich, weil sie nicht sehen, was alles in dir steckt.",

  "Du hast hohe Ansprüche an dich selbst.",

  "Es gibt etwas, das du schon lange tun möchtest, aber bisher aufgeschoben hast.",

  "Du bist grundsätzlich offen für Neues, solange es sich für dich richtig anfühlt.",

  "In einer wichtigen Angelegenheit wird sich bald mehr Klarheit ergeben.",

  "Du erinnerst dich oft an Situationen, die andere längst vergessen haben.",

  "Du bist sensibler, als viele Menschen vermuten.",

  "Gelegentlich fragst du dich, ob du den Erwartungen anderer gerecht wirst.",

  "Du hast in den vergangenen Monaten eine schwierige Phase besser gemeistert, als dir bewusst ist.",

  "Ein unerwartetes Gespräch könnte dir neue Perspektiven eröffnen.",

  "Du spürst oft intuitiv, wenn etwas nicht stimmt.",

  "Manchmal wünschst du dir mehr Anerkennung für das, was du leistest.",

  "Du befindest dich an einem Punkt, an dem kleine Entscheidungen große Auswirkungen haben können.",

  "Es gibt jemanden in deinem Umfeld, der mehr über dich nachdenkt, als du glaubst.",

  "Du bist nicht gerne in Schubladen einzuordnen.",

  "Du hast sowohl eine rationale als auch eine kreative Seite.",

  "Eine Gelegenheit, die zunächst unbedeutend wirkt, könnte sich als wichtig erweisen.",

  "Du trägst eine Erinnerung mit dir, die dich bis heute beeinflusst.",

  "In den kommenden Wochen wird Geduld wichtiger sein als Schnelligkeit.",

  "Du neigst dazu, anderen zu helfen, auch wenn du selbst Unterstützung gebrauchen könntest.",

  "Es fällt dir leichter, die Probleme anderer zu lösen als deine eigenen.",

  "Eine Entwicklung, die du bereits abgeschrieben hattest, könnte erneut relevant werden.",

  "Du hast das Gefühl, dass eine wichtige Veränderung näher rückt.",

  "Manchmal unterschätzt du, welchen Einfluss du auf andere Menschen hast.",

  "Du suchst nach Stabilität, möchtest aber gleichzeitig deine Freiheit bewahren.",

  "Nicht alles, was derzeit unklar erscheint, wird verborgen bleiben.",

  "Du bist stärker, als du dir in schwierigen Momenten eingestehst."

];


/* =========================================================
   ELEMENTE
   ========================================================= */

const video = document.querySelector("#video");
const statusEl = document.querySelector("#status");
const progress = document.querySelector("#progress");

const message = document.querySelector("#message");
const restart = document.querySelector("#restart");

const start = document.querySelector("#start");
const startBtn = document.querySelector("#startBtn");

const instructions = document.querySelector("#instructions");
const errorEl = document.querySelector("#error");


/* =========================================================
   VARIABLEN
   ========================================================= */

let detector = null;

let cameraStream = null;

let faceStart = null;

let triggered = false;

let lastVideoTime = -1;

let lastStatement = -1;


/* =========================================================
   AUSSAGE AUSWÄHLEN
   ========================================================= */

function pickStatement() {

  let i;

  do {
    i = Math.floor(Math.random() * statements.length);
  }
  while (
    statements.length > 1 &&
    i === lastStatement
  );

  lastStatement = i;

  return statements[i];
}


/* =========================================================
   MEDIAPIPE LADEN
   ========================================================= */

async function initDetector() {

  statusEl.textContent =
    "Gesichtserkennung wird geladen …";

  const vision =
    await FilesetResolver.forVisionTasks(
      "https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.22/wasm"
    );


  detector =
    await FaceDetector.createFromOptions(
      vision,
      {

        baseOptions: {

          modelAssetPath:
            "https://storage.googleapis.com/mediapipe-models/face_detector/blaze_face_short_range/float16/1/blaze_face_short_range.tflite"

        },

        runningMode: "VIDEO",

        minDetectionConfidence: 0.55

      }
    );
}


/* =========================================================
   KAMERA STARTEN
   ========================================================= */

async function startCamera() {

  startBtn.disabled = true;

  startBtn.textContent =
    "Kamera wird gestartet …";

  errorEl.style.display = "none";

  try {

    /* -----------------------------------------
       SICHERHEITSCHECK
       ----------------------------------------- */

    if (
      !window.isSecureContext &&
      location.hostname !== "localhost"
    ) {

      throw new Error(
        "Diese Seite läuft nicht über HTTPS. " +
        "Bitte öffne sie über eine HTTPS-Webadresse."
      );

    }


    /* -----------------------------------------
       KAMERA-API CHECK
       ----------------------------------------- */

    if (
      !navigator.mediaDevices ||
      !navigator.mediaDevices.getUserMedia
    ) {

      throw new Error(
        "Der Browser stellt keine Kamera-API bereit."
      );

    }


    /* -----------------------------------------
       KAMERA ÖFFNEN
       ----------------------------------------- */

    statusEl.textContent =
      "Kamera wird geöffnet …";


    cameraStream =
      await navigator.mediaDevices.getUserMedia({

        video: {

          facingMode: {
            ideal: "user"
          },

          width: {
            ideal: 1280
          },

          height: {
            ideal: 720
          }

        },

        audio: false

      });


    /* -----------------------------------------
       VIDEO VERBINDEN
       ----------------------------------------- */

    video.srcObject =
      cameraStream;


    await video.play();


    /* -----------------------------------------
       KAMERA IST JETZT SICHTBAR
       ----------------------------------------- */

    start.classList.add("hidden");


    statusEl.textContent =
      "Gesichtserkennung wird geladen …";


    /* -----------------------------------------
       MEDIAPIPE LADEN
       ----------------------------------------- */

    await initDetector();


    statusEl.textContent =
      "Schau in die Kamera";


    lastVideoTime = -1;

    faceStart = null;

    triggered = false;


    requestAnimationFrame(loop);

  }

  catch (err) {

    console.error(
      "KAMERA FEHLER:",
      err
    );


    /* Kamera wieder schließen */

    if (cameraStream) {

      cameraStream
        .getTracks()
        .forEach(track => track.stop());

      cameraStream = null;

    }


    /* -----------------------------------------
       FEHLERMELDUNGEN
       ----------------------------------------- */

    let text =
      "Kamera konnte nicht gestartet werden.";


    if (err.name === "NotAllowedError") {

      text =
        "Der Kamerazugriff wurde verweigert. " +
        "Bitte erlaube Safari den Kamerazugriff.";

    }

    else if (err.name === "NotFoundError") {

      text =
        "Es wurde keine Kamera gefunden.";

    }

    else if (err.name === "NotReadableError") {

      text =
        "Die Kamera wird bereits von einer anderen App verwendet.";

    }

    else if (err.name === "OverconstrainedError") {

      text =
        "Die Kamera unterstützt die gewünschte Einstellung nicht.";

    }

    else if (err.message) {

      text =
        err.message;

    }


    errorEl.textContent =
      text;

    errorEl.style.display =
      "block";


    instructions.textContent =
      "Bitte überprüfe die Kameraberechtigung und die Internetverbindung.";


    startBtn.disabled = false;

    startBtn.textContent =
      "Erneut versuchen";

  }

}


/* =========================================================
   DETECTION ZURÜCKSETZEN
   ========================================================= */

function resetDetection() {

  faceStart = null;

  triggered = false;

  progress.style.width =
    "0%";

  message.classList.remove("show");

  message.textContent =
    "";

  statusEl.textContent =
    "Schau in die Kamera";

}


/* =========================================================
   HAUPTSCHLEIFE
   ========================================================= */

function loop() {

  if (
    !detector ||
    video.readyState < 2
  ) {

    requestAnimationFrame(loop);

    return;

  }


  const now =
    performance.now();


  if (
    video.currentTime !== lastVideoTime &&
    !triggered
  ) {

    lastVideoTime =
      video.currentTime;


    let result;


    try {

      result =
        detector.detectForVideo(
          video,
          now
        );

    }

    catch (err) {

      console.error(
        "Face detection error:",
        err
      );

      requestAnimationFrame(loop);

      return;

    }


    const faceVisible =
      result.detections &&
      result.detections.length > 0;


    if (faceVisible) {

      if (faceStart === null) {

        faceStart =
          now;

      }


      const elapsed =
        now - faceStart;


      const pct =
        Math.min(
          100,
          (elapsed / 5000) * 100
        );


      progress.style.width =
        pct + "%";


      const remaining =
        Math.max(
          0,
          Math.ceil(
            (5000 - elapsed) / 1000
          )
        );


      statusEl.textContent =
        remaining > 0
          ? `Gesicht erkannt · ${remaining}`
          : "Gesicht erkannt";


      if (elapsed >= 5000) {

        triggered = true;

        progress.style.width =
          "100%";

        statusEl.textContent =
          "";

        message.textContent =
          pickStatement();

        message.classList.add("show");

      }

    }

    else {

      faceStart = null;

      progress.style.width =
        "0%";

      statusEl.textContent =
        "Schau in die Kamera";

    }

  }


  requestAnimationFrame(loop);

}


/* =========================================================
   BUTTONS
   ========================================================= */

startBtn.addEventListener(
  "click",
  startCamera
);


restart.addEventListener(
  "click",
  resetDetection
);


message.addEventListener(
  "click",
  resetDetection
);

</script>

</body>
</html>
